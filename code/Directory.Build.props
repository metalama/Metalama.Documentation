<Project>

    <Import Project="..\Directory.Build.props" />
    
    <PropertyGroup>

        <Nullable>enable</Nullable>
        <DebugMetalama>False</DebugMetalama>
        <MetalamaWriteHtml>True</MetalamaWriteHtml>

        <!-- The latest version supported by Metalama Compiler may be higher that the latest version supported by Metalama Framework. -->
        <LangVersion>$(LangMaxVersion)</LangVersion>

        <!-- The tests are written with xunit.v3 and are run by VSTest (xunit.runner.visualstudio), because the build
             runs 'dotnet test' in its VSTest mode. xunit.v3 declares a test project to be a Microsoft.Testing.Platform
             application by default, and the .NET 10 SDK refuses such a project in the VSTest mode. The property has
             no effect on a project that does not reference xunit.v3. -->
        <IsTestingPlatformApplication>false</IsTestingPlatformApplication>

        <!-- xUnit1051 reports every call in a test that accepts a cancellation token and receives none. These calls
             were written before xunit.v3. Passing the cancellation token of xunit to them is a separate change. -->
        <!-- xUnit1069 reports every test that has a Timeout and does not use Xunit.TestContext.Current.CancellationToken.
             These tests were written before xunit.v3, and changing them is part of the same separate change. -->
        <NoWarn>$(NoWarn);xUnit1051;xUnit1069</NoWarn>

    </PropertyGroup>
</Project>