<Project Sdk="Microsoft.NET.Sdk">

    <!-- Error and warning reference: one folder per diagnostic ID, each with an *_Error and a *_Fixed snapshot test.
         See .claude/skills/document-diagnostics/SKILL.md. -->

    <PropertyGroup>
        <OutputType>Library</OutputType>
        <!-- Windows and WPF for the Metalama.Patterns.Wpf diagnostics. -->
        <TargetFramework>net10.0-windows</TargetFramework>
        <UseWPF>true</UseWPF>
        <!-- For the diagnostics about unsafe code in compile-time code and templates. -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <StartupObject>AutoGeneratedProgram</StartupObject>
        <RootNamespace>Doc</RootNamespace>
        <NoWarn>1701;1702;169;649;67;8618;VSTHRD200</NoWarn>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="Microsoft.Win32.Registry" />
        <PackageReference Include="xunit" />
        <PackageReference Include="xunit.runner.visualstudio">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>

        <PackageReference Include="Metalama.Framework" />
        <PackageReference Include="Metalama.Testing.AspectTesting" />

        <!-- Packages whose diagnostics are documented here. -->
        <PackageReference Include="Metalama.Extensions.Architecture" />
        <PackageReference Include="Metalama.Extensions.CodeFixes" />
        <PackageReference Include="Metalama.Extensions.DependencyInjection" />
        <PackageReference Include="Metalama.Patterns.Caching.Aspects" />
        <PackageReference Include="Metalama.Patterns.Contracts" />
        <PackageReference Include="Metalama.Patterns.Immutability" />
        <PackageReference Include="Metalama.Patterns.Memoization" />
        <PackageReference Include="Metalama.Patterns.Observability" />
        <PackageReference Include="Metalama.Patterns.Wpf" />

        <!-- For the diagnostics about aspect weavers. -->
        <PackageReference Include="Metalama.Framework.Sdk" />
    </ItemGroup>

    <!-- WPF references Accessibility.dll, whose Accessibility namespace hides Metalama.Framework.Code.Accessibility. -->
    <Target Name="RemoveAccessibilityReference" AfterTargets="ResolveTargetingPackAssets">
        <ItemGroup>
            <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Accessibility'" />
        </ItemGroup>
    </Target>

</Project>
